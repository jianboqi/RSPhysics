# Keep source checkouts consistent on Windows, Linux, and macOS.
* text=auto eol=lf

# Scientific resources and golden fixtures are hashed as exact bytes.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.tsv -text
*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.txt -text
# Preserve the exact author vector tables, including original whitespace.
crates/models/soil/gsv/data/*.txt -text -whitespace
*.dat -text
*.zlib binary
# Preserve the original 6SV2.1 distribution byte for byte.
crates/models/atmosphere/sixs/fortran/upstream/** -text -whitespace
# Preserve the official GNU runtime license texts verbatim.
bindings/python/python/rsphysics/GCC_RUNTIME_EXCEPTION.txt -text -whitespace
bindings/python/python/rsphysics/LGPL-2.1.txt -text -whitespace
